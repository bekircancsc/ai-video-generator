{
  "name": "Publish a video",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                1
              ],
              "triggerAtHour": 9
            }
          ]
        }
      },
      "id": "schedule",
      "name": "Weekly",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "command": "cd /d \"C:\\Users\\bekircan\\OneDrive\\MASAST~1\\AI-VID~1\" && node run.mjs --niche-file niches/floor-four.md --scenes 6 --json --stage C:\\n8n-data"
      },
      "id": "render",
      "name": "Render",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        220,
        0
      ],
      "notes": "The node has no working-directory setting, so the cd is part of the command. The 8.3 short path is deliberate: cmd.exe cannot read the accented characters in the real path. --stage drops a copy of the video and cover in C:\\n8n-data under fixed names, which is the only place n8n is allowed to read files from. Call node directly, not npm: npm prints its own banner to stdout and would break the JSON contract."
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.stdout ?? '';\nlet result;\ntry {\n  result = JSON.parse(raw);\n} catch {\n  throw new Error('The render did not return JSON. stderr: ' + ($json.stderr ?? '').slice(-800));\n}\nif (!result.ok) {\n  throw new Error(result.error);\n}\nreturn [{ json: result }];"
      },
      "id": "parse",
      "name": "Read the result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "fileSelector": "C:\\n8n-data\\video.mp4",
        "options": {
          "dataPropertyName": "data"
        }
      },
      "id": "readvideo",
      "name": "Read the video",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        660,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "notes": "Read/Write Files from Disk, not the older Read Binary File: that node is deprecated and fails on current n8n with 'The file has changed and cannot be accessed'."
    },
    {
      "parameters": {
        "resource": "video",
        "operation": "upload",
        "title": "={{ $('Read the result').item.json.title }}",
        "regionCode": "US",
        "categoryId": "24",
        "options": {
          "description": "={{ $('Read the result').item.json.description }}",
          "tags": "={{ $('Read the result').item.json.tags.join(',') }}",
          "privacyStatus": "private",
          "selfDeclaredMadeForKids": false
        }
      },
      "id": "upload",
      "name": "Upload to YouTube",
      "type": "n8n-nodes-base.youTube",
      "typeVersion": 1,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "fileSelector": "C:\\n8n-data\\cover.jpg",
        "options": {
          "dataPropertyName": "data"
        }
      },
      "id": "readcover",
      "name": "Read the cover",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        1100,
        0
      ],
      "notes": "A run with --no-cover stages no cover. Disable this node and the one after it if you turn covers off.",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://www.googleapis.com/upload/youtube/v3/thumbnails/set?videoId={{ $('Upload to YouTube').item.json.uploadId }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "youTubeOAuth2Api",
        "sendBody": true,
        "contentType": "binaryData",
        "inputDataFieldName": "data",
        "options": {}
      },
      "notes": "videoId comes from uploadId, not id. The YouTube node uploads in resumable chunks and returns { uploadId, ...initiateResponse.body }; the initiate call has an empty body, so there is no id field. Reading .id sends videoId=undefined, and the HTTP Request node hides Google refusal behind a circular-structure error.",
      "id": "thumbnail",
      "name": "Set the cover",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        0
      ]
    },
    {
      "parameters": {
        "text": "=Ready: {{ $('Read the result').item.json.title }}\nhttps://youtube.com/watch?v={{ $('Upload to YouTube').item.json.uploadId }}\n{{ $('Read the result').item.json.durationSeconds }}s, private. Review it before publishing.",
        "additionalFields": {}
      },
      "id": "notify",
      "name": "Tell me",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1540,
        0
      ]
    }
  ],
  "connections": {
    "Weekly": {
      "main": [
        [
          {
            "node": "Render",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Render": {
      "main": [
        [
          {
            "node": "Read the result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read the result": {
      "main": [
        [
          {
            "node": "Read the video",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read the video": {
      "main": [
        [
          {
            "node": "Upload to YouTube",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upload to YouTube": {
      "main": [
        [
          {
            "node": "Read the cover",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read the cover": {
      "main": [
        [
          {
            "node": "Set the cover",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set the cover": {
      "main": [
        [
          {
            "node": "Tell me",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
