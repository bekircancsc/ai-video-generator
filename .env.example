# Which backend writes the video script.
# groq | openrouter | openai | ollama | gemini | manual
SCRIPT_PROVIDER=groq

# Used by every OpenAI-compatible provider (groq, openrouter, openai, ollama).
# Leave LLM_BASE_URL and LLM_MODEL empty to accept the provider's defaults.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Only needed when SCRIPT_PROVIDER=gemini
GEMINI_API_KEY=

# Voiceover. Reuses LLM_API_KEY; only groq is supported today.
# Voices: autumn, diana, hannah, austin, daniel, troy
TTS_PROVIDER=groq
TTS_VOICE=daniel
TTS_MODEL=

# Captions. Reuses LLM_API_KEY. Leave empty for whisper-large-v3-turbo.
TRANSCRIBE_MODEL=

# Scene imagery. pollinations (keyless, default) | together | none
IMAGE_PROVIDER=pollinations
IMAGE_API_KEY=
IMAGE_MODEL=

# Publishing. Only needed by `npm run publish`, which is how CI uploads; the
# local n8n workflow holds its own copies of these and reads none of them.
# Get the refresh token once with scripts/youtube-authorise.mjs.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Where the finished-video notice goes. Token from @BotFather; chat id from
# https://api.telegram.org/bot<token>/getUpdates after messaging the bot once.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
