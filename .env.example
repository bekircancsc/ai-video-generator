# Which backend writes the video script.
# groq | openrouter | openai | ollama | gemini | manual
SCRIPT_PROVIDER=groq

# Used by every OpenAI-compatible provider (groq, openrouter, openai, ollama).
# Leave LLM_BASE_URL and LLM_MODEL empty to accept the provider's defaults.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Only needed when SCRIPT_PROVIDER=gemini
GEMINI_API_KEY=

# Voiceover. Reuses LLM_API_KEY; only groq is supported today.
# Voices: autumn, diana, hannah, austin, daniel, troy
TTS_PROVIDER=groq
TTS_VOICE=daniel
TTS_MODEL=
